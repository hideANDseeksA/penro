# --- database (pick one) ---
DATABASE_URL=postgresql+psycopg://soiltax:secret@localhost:5432/soiltax
# DATABASE_URL=mysql+pymysql://soiltax:secret@localhost:3306/soiltax?charset=utf8mb4
# DATABASE_URL=sqlite+pysqlite:///./soiltax.db
# DATABASE_URL=postgresql+psycopg2://postgres:admin%40123@localhost:5432/penro
SQL_ECHO=false

# --- session cookie ---
SECRET_KEY=replace-with-openssl-rand-hex-32
SESSION_TTL_MINUTES=60
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=treasury.camarinesnorte.gov.ph

# --- API keys: key:label:requests_per_minute ---
API_KEYS=dev-key-treasurer:treasurer-portal:120,dev-key-penro:penro-portal:60

# --- rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_BURST=20
RATE_LIMIT_LOGIN_PER_MINUTE=5

# --- pagination ---
PAGE_SIZE_DEFAULT=25
PAGE_SIZE_MAX=200

# --- seeding ---
SEED_ADMIN_PASSWORD=ChangeMeNow!2026
SEED_DEMO=0
